# Local development configuration.
# Copy to .env (`make setup` does this). Values below are for local Docker
# containers only and must never be used in any shared environment.

# --- PostgreSQL ---
POSTGRES_PORT=15432
# Superuser for the local container only; used by init scripts.
POSTGRES_SUPERUSER_PASSWORD=change-me-local-superuser
POSTGRES_DB=avenra
# Owns the schema and runs Flyway migrations.
AVENRA_DB_OWNER_USER=avenra_owner
AVENRA_DB_OWNER_PASSWORD=change-me-local-owner
# Runtime role used by the application; cannot bypass row-level security.
AVENRA_DB_APP_USER=avenra_app
AVENRA_DB_APP_PASSWORD=change-me-local-app

# --- Redis ---
REDIS_PORT=16379
REDIS_PASSWORD=change-me-local-redis

# --- S3-compatible object storage (SeaweedFS) ---
S3_PORT=18333
S3_ACCESS_KEY=avenra-local-access
S3_SECRET_KEY=change-me-local-s3-secret
S3_BUCKET=avenra-local
