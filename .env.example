# Local development configuration.
# Copy to .env (`make setup` does this). Values below are for local Docker
# containers only and must never be used in any shared environment.

# --- API ---
# Environment profile: local | development | staging | production
SPRING_PROFILES_ACTIVE=local

# Redis for rate limiting (ADR-016). Local container only.
AVENRA_REDIS_URL=redis://:change-me-local-redis@127.0.0.1:16379
# Application-level encryption keys (ADR-017). Generate a local key with:
#   openssl rand -base64 32
AVENRA_CRYPTO_ACTIVE_KEY_ID=local1
AVENRA_CRYPTO_KEYS_LOCAL1=replace-with-32-random-bytes-base64

# --- Web ---
# The browser talks only to the web app; it forwards /api/* to this address
# (ADR-013). Server-side only, read at runtime.
AVENRA_API_INTERNAL_URL=http://127.0.0.1:8080

# --- AI service ---
AVENRA_AI_ENVIRONMENT=LOCAL
AVENRA_AI_LOG_JSON=false

# --- PostgreSQL ---
POSTGRES_PORT=15432
# Superuser for the local container only; used by init scripts.
POSTGRES_SUPERUSER_PASSWORD=change-me-local-superuser
POSTGRES_DB=avenra
# JDBC URL the API uses for both connections below.
AVENRA_DB_URL=jdbc:postgresql://127.0.0.1:15432/avenra
# Owns the schema and runs Flyway migrations.
AVENRA_DB_OWNER_USER=avenra_owner
AVENRA_DB_OWNER_PASSWORD=change-me-local-owner
# Runtime role used by the application; cannot bypass row-level security.
AVENRA_DB_APP_USER=avenra_app
AVENRA_DB_APP_PASSWORD=change-me-local-app

# --- Redis ---
REDIS_PORT=16379
REDIS_PASSWORD=change-me-local-redis

# --- S3-compatible object storage (SeaweedFS) ---
S3_PORT=18333
S3_ACCESS_KEY=avenra-local-access
S3_SECRET_KEY=change-me-local-s3-secret
S3_BUCKET=avenra-local
